<?xml version="1.0" encoding="utf-8"?>
<!--
    Страницу книги показывает навигатор Readium — это фрагмент, и он обязан
    быть обычной View.

    Всё остальное — панели, настройки, оглавление — лежит в наложении на
    Compose: лист настроек, выезжающее оглавление и ползунок с подсказкой
    на View обошлись бы втрое дороже.

    Отступы системных панелей ставятся в коде: текст книги не должен
    уходить под часы и под полосу жеста.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/reader_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/reader_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
