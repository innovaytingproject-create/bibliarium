<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bibliarium" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
        Экран чтения держит фрагменты Readium, а они разворачивают виджеты
        AppCompat: без темы AppCompat такие виджеты падают при инфляции.
    -->
    <style name="Theme.Bibliarium.Reader" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
