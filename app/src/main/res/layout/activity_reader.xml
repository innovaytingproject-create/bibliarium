<?xml version="1.0" encoding="utf-8"?>
<!--
    Навигаторы Readium — фрагменты, поэтому содержимое книги живёт в обычном
    FragmentContainerView, а панели рисует Compose поверх него.
    Когда панели скрыты, overlay уходит в GONE: иначе он перехватывал бы
    касания, которыми листают страницы.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/reader_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/reader_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
